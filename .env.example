# Postgres (pgvector-railway service on Railway; local docker-compose db locally)
DATABASE_URL=postgresql+asyncpg://haru:haru@localhost:5432/haru

# Redis (Redis service on Railway; local docker-compose redis locally)
REDIS_URL=redis://localhost:6379/0

# Comma-separated allowed CORS origins for the Lovable client.
# Railway: set to the exact Lovable preview + published domain(s), e.g.
#   https://id-preview--712b85ce-b275-45b4-875d-28ef749339a5.lovable.app,https://haru.lovable.app
CORS_ORIGINS=https://id-preview--712b85ce-b275-45b4-875d-28ef749339a5.lovable.app

# Regex fallback so every Lovable preview subdomain works without redeploying
# the backend each time the preview URL changes (Lovable rotates the id-preview
# subdomain per project). Leave as-is unless you self-host the frontend.
CORS_ORIGIN_REGEX=^https://.*\.lovable\.app$

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# Gemini API (server-side only — never exposed to the client)
GEMINI_API_KEY=

# Daily per-learner AI call budget (SDD: "mọi lời gọi AI ... có hạn mức mỗi ngày")
AI_DAILY_JOB_LIMIT=200

ENVIRONMENT=development
